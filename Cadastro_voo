#include <stdio.h>

struct DADOSVOO {
    char cidadeOrigem[200];
    char cidadeDestino[200];
    int tempVoo;              // minutos
    float distancia;          // km
    char empresaAerea[200];
    float velocidadeMedia;    // km/h
    float custoPorKm;
    int nEscala;
    float custo;
};

class VOO {
private:
    DADOSVOO voo;

    void calcular() {
        if (voo.distancia > 0)
            voo.custoPorKm = voo.custo / voo.distancia;
        else
            voo.custoPorKm = 0;

        // O tempo é informado em minutos; para km/h, converte-se para horas.
        if (voo.tempVoo > 0)
            voo.velocidadeMedia = voo.distancia / (voo.tempVoo / 60.0f);
        else
            voo.velocidadeMedia = 0;
    }

public:
    VOO() {
        voo.cidadeOrigem[0] = '\0';
        voo.cidadeDestino[0] = '\0';
        voo.empresaAerea[0] = '\0';
        voo.tempVoo = 0;
        voo.distancia = 0;
        voo.velocidadeMedia = 0;
        voo.custoPorKm = 0;
        voo.nEscala = 0;
        voo.custo = 0;
    }

    void cadastrarVoo() {
        printf("Cidade de origem: ");
        scanf(" %199[^\n]", voo.cidadeOrigem);

        printf("Cidade de destino: ");
        scanf(" %199[^\n]", voo.cidadeDestino);

        printf("Tempo de voo (minutos): ");
        scanf("%d", &voo.tempVoo);

        printf("Distancia (km): ");
        scanf("%f", &voo.distancia);

        printf("Empresa aerea: ");
        scanf(" %199[^\n]", voo.empresaAerea);

        printf("Quantidade de escalas: ");
        scanf("%d", &voo.nEscala);

        printf("Custo do voo (R$): ");
        scanf("%f", &voo.custo);

        calcular();
    }

    const char* getCidadeOrigem() const { return voo.cidadeOrigem; }
    const char* getCidadeDestino() const { return voo.cidadeDestino; }
    int getTempVoo() const { return voo.tempVoo; }
    float getDistancia() const { return voo.distancia; }
    const char* getEmpresaAerea() const { return voo.empresaAerea; }
    int getEscalas() const { return voo.nEscala; }
    float getCusto() const { return voo.custo; }
    float getVelocidadeMedia() const { return voo.velocidadeMedia; }
    float getCustoPorKm() const { return voo.custoPorKm; }
};

int main() {
    VOO voo;

    printf("=== CADASTRO DE VOO ===\n");
    voo.cadastrarVoo();

    printf("\n=== DADOS DO VOO ===\n");
    printf("CIDADE ORIGEM: %s\n", voo.getCidadeOrigem());
    printf("CIDADE DESTINO: %s\n", voo.getCidadeDestino());
    printf("TEMPO: %d min\n", voo.getTempVoo());
    printf("DISTANCIA: %.2f km\n", voo.getDistancia());
    printf("EMPRESA AEREA: %s\n", voo.getEmpresaAerea());
    printf("ESCALAS: %d\n", voo.getEscalas());
    printf("CUSTO: R$ %.2f\n", voo.getCusto());
    printf("VELOCIDADE MEDIA: %.2f km/h\n", voo.getVelocidadeMedia());
    printf("CUSTO POR KM: R$ %.4f\n", voo.getCustoPorKm());

    return 0;
}
